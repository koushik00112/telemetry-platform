# Copy to backend.hcl and fill in the bucket from `terraform output state_bucket` in ../bootstrap.
bucket       = "telemetry-tfstate-123456789012"
key          = "app/terraform.tfstate"
region       = "eu-west-2"
encrypt      = true
use_lockfile = true # S3-native state locking (Terraform >= 1.10), no DynamoDB table needed
